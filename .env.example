# Copy to .env, fill locally, then chmod 600 .env. Never commit real values.
LAMBDA_API_KEY=
# Optional: expose the key only to the workload process launched by run.sh.
# The project CLI always reads LAMBDA_API_KEY locally for API access.
LAMBDA_FORWARD_API_KEY=0
# RunPod REST v2 migration CLI; do not commit a real key.
RUNPOD_API_KEY=
